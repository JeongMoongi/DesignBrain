[Unit]
Description=ngrok 터널 (노션 웹훅 → DesignBrain)
After=network-online.target designbrain.service
Wants=network-online.target

[Service]
User=__USER__
# 설치 위치가 환경마다 달라 setup.sh가 실제 경로로 채운다
ExecStart=__NGROK_BIN__ http --url=__NGROK_DOMAIN__ 8000 --log stdout
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
